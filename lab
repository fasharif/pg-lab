#!/usr/bin/env bash
# pg-lab: one entry point for the whole lab. Needs Docker (with Compose v2) and bash;
# everything else runs in containers. Run ./lab help for the command list.
set -Eeuo pipefail

# Git Bash on Windows rewrites arguments that look like POSIX paths; container paths must
# reach Docker unchanged.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'

LAB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Docker Desktop on Windows needs a Windows-style path; "pwd -W" exists only in Git Bash.
LAB_ROOT_HOST="$(cd "$LAB_ROOT" && { pwd -W 2>/dev/null || pwd; })"
export LAB_ROOT LAB_ROOT_HOST
# shellcheck source=scripts/lib.sh
source "$LAB_ROOT/scripts/lib.sh"
# shellcheck source=scripts/drills.sh
source "$LAB_ROOT/scripts/drills.sh"
# shellcheck source=scripts/sqlserver.sh
source "$LAB_ROOT/scripts/sqlserver.sh"

usage() {
  cat <<'EOF'
Usage: ./lab <command> [options]

Setup
  init                     create .env with random passwords (never committed)
  up                       build images, start the primary and the tools container, migrate
  migrate                  apply TopFlow's migrations, the lab schema and the security layer
  seed [--scale N]         generate data; N = approximate order lines (default LAB_SCALE)
  status                   containers, node roles and row counts
  psql [--node N] [--user U]   interactive psql (default: current primary, postgres)
  down                     stop everything and delete all lab volumes

Performance
  workload [--measure] [--runs N] [--state baseline|tuned|current]
                           rank every API statement by buffers touched (reports/workload.md)
  casebook [--measure] [--runs N]
                           before/after plans of the ten slowest, with plan checks
                           (reports/casebook.md); leaves the schema tuned
  tune | untune            apply or revert every casebook fix
  indexing                 index sizes and WAL per inserted row, before and after the
                           casebook (reports/indexing.md); leaves the schema tuned

Partitioning
  partition [--measure]    build monthly partitions of orders and audit_logs in schema part,
                           check pruning, measure retention (reports/partitioning.md)
  partition-maintain [--ahead N] [--retain M] [--as-of YYYY-MM-DD]
                           create partitions N months ahead, detach those older than M months

  --measure records median timings; use it only on a quiet machine (docs/benchmarking.md).

Reliability
  pitr-drill [--measure]   full backup, DELETE without WHERE, restore to just before it with
                           pgBackRest, verify counts and checksums (reports/pitr-drill.md)
  replica up|status|down   streaming standby of the current primary (slot + pg_basebackup)
  switchover [--measure]   planned switchover: promote the standby, pg_rewind the old primary
                           and rejoin it, while a client keeps writing
                           (reports/switchover-drill.md); run it twice to switch back

Monitoring
  monitor up|down          postgres_exporter per node, Prometheus (alert rules) and Grafana
                           (provisioned dashboard) on 127.0.0.1:55430
  load [--seconds N] [--clients N]
                           pgbench with TopFlow back-office traffic (default 120 s, 4 clients)

Security
  rls-plans                the tenant's order page under two policy designs
                           (reports/rls-plans.md); leaves the schema tuned

SQL Server chapter (written, not run: needs MSSQL_ACCEPT_EULA=Y from you)
  sqlserver up|seed [--scale N]|casebook|down
                           the casebook on SQL Server 2022 Developer edition

Tests
  test                     pgTAP suites (schema, privileges, tenant isolation, SCRAM,
                           partition functions) and the integration tests; needs seeded data
  check                    static checks: ruff, mypy, unit tests, definitions, sqlfluff,
                           promtool, shellcheck

Help
  help                     this text
EOF
}

# Prints the lines of .env.example, with a random value for every "change-me" placeholder.
env_lines() {
  local line key value
  while IFS= read -r line || [ -n "$line" ]; do
    key=${line%%=*}
    value=${line#*=}
    if [ "$value" = "change-me" ]; then
      # "Lab-" adds the upper-case letter and symbol that SQL Server's password policy wants.
      value="Lab-$(od -An -tx1 -N18 /dev/urandom | tr -d ' \n')"
      printf '%s=%s\n' "$key" "$value"
    else
      printf '%s\n' "$line"
    fi
  done <"$LAB_ROOT/.env.example"
}

cmd_init() {
  umask 077
  if [ ! -f "$LAB_ROOT/.env" ]; then
    env_lines >"$LAB_ROOT/.env"
    log "created .env with random passwords"
    return 0
  fi
  # Keep existing values; add settings that are new in .env.example.
  local line added=0
  while IFS= read -r line; do
    grep -q "^${line%%=*}=" "$LAB_ROOT/.env" && continue
    printf '%s\n' "$line" >>"$LAB_ROOT/.env"
    info "added ${line%%=*} to .env"
    added=1
  done < <(env_lines)
  [ "$added" = 1 ] || info ".env is up to date"
}

cmd_up() {
  [ -f "$LAB_ROOT/.env" ] || cmd_init
  log "building images and starting pg1 and the runner"
  compose up -d --build --wait pg1 runner
  cmd_migrate
}

cmd_migrate() {
  require_env
  ensure_runner
  log "migrating the schema"
  runner bash scripts/migrate.sh
}

cmd_seed() {
  require_env
  local scale
  scale=$(env_value LAB_SCALE 100000)
  while [ $# -gt 0 ]; do
    case $1 in
      --scale) scale=${2:?--scale needs a number}; shift 2 ;;
      *) die "seed: unknown option $1" ;;
    esac
  done
  [[ $scale =~ ^[0-9]+$ ]] || die "seed: --scale must be a whole number (got '$scale')"
  ensure_runner
  log "generating data at SCALE=$scale (about $scale order lines)"
  runner psql -X -v ON_ERROR_STOP=1 -v scale="$scale" -f sql/generate/generate.sql
}

cmd_workload() {
  require_env
  ensure_runner
  log "ranking the workload"
  pglab "./lab workload $*" workload "$@"
}

cmd_casebook() {
  require_env
  ensure_runner
  log "running the casebook"
  pglab "./lab casebook $*" casebook "$@"
}

cmd_indexing() {
  require_env
  ensure_runner
  log "measuring index sizes and write cost"
  pglab "./lab indexing" index-report "$@"
}

cmd_partition() {
  require_env
  ensure_runner
  log "building the partitioned tables"
  # shellcheck disable=SC2016 # expanded by the shell inside the runner container
  runner bash -c 'PGUSER=topflow_migrator PGPASSWORD="$LAB_MIGRATOR_PASSWORD" PGOPTIONS="-c client_min_messages=warning" psql -X -q -v ON_ERROR_STOP=1 -f sql/partitioning/10_partitioned_tables.sql'
  pglab "./lab partition $*" partition "$@"
}

cmd_partition_maintain() {
  require_env
  ensure_runner
  pglab "./lab partition-maintain $*" partition-maintain "$@"
}

cmd_tune() {
  require_env
  ensure_runner
  pglab "./lab tune" casebook-state tuned
}

cmd_untune() {
  require_env
  ensure_runner
  pglab "./lab untune" casebook-state baseline
}

cmd_rls_plans() {
  require_env
  ensure_runner
  log "comparing plans under row-level security"
  pglab "./lab rls-plans" rls-report "$@"
}

cmd_replica() {
  local action=${1:-status}
  [ $# -gt 0 ] && shift
  case $action in
    up) replica_up "$@" ;;
    status) replica_status "$@" ;;
    down) replica_down "$@" ;;
    *) die "replica: expected up, status or down" ;;
  esac
}

MONITORING_SERVICES=(exporter-pg1 exporter-pg2 prometheus grafana)

cmd_monitor() {
  require_env
  case ${1:-up} in
    up)
      log "starting exporters, Prometheus and Grafana"
      compose --profile monitoring up -d --build --wait "${MONITORING_SERVICES[@]}"
      ensure_runner
      # Grafana migrates its own database on first start; that can take minutes.
      local waited=0
      until runner python -c "import urllib.request; urllib.request.urlopen('http://grafana:3000/api/health', timeout=3)" 2>/dev/null; do
        [ "$waited" -ge 300 ] && die "Grafana did not answer within 300s (docker logs pg-lab-grafana)"
        sleep 5
        waited=$((waited + 5))
      done
      info "Grafana:    http://127.0.0.1:$(env_value LAB_GRAFANA_PORT 55430)/d/pglab-postgres (anonymous read-only)"
      info "Prometheus: http://127.0.0.1:$(env_value LAB_PROMETHEUS_PORT 55490)/alerts"
      ;;
    down)
      compose --profile monitoring rm -sf "${MONITORING_SERVICES[@]}"
      ;;
    *) die "monitor: expected up or down" ;;
  esac
}

cmd_load() {
  require_env
  local seconds=120 clients=4 primary
  while [ $# -gt 0 ]; do
    case $1 in
      --seconds) seconds=${2:?}; shift 2 ;;
      --clients) clients=${2:?}; shift 2 ;;
      *) die "load: unknown option $1" ;;
    esac
  done
  [[ $seconds =~ ^[0-9]+$ && $clients =~ ^[0-9]+$ ]] || die "load: --seconds and --clients take whole numbers"
  primary=$(primary_host)
  log "pgbench on $primary for ${seconds}s with $clients clients (topflow_backoffice)"
  # pgbench ships with the server package, so it runs from the node's own container.
  compose cp workload/pgbench.sql "$primary:/tmp/pgbench.sql" >/dev/null
  compose exec -T -u postgres -e PGPASSWORD="$(env_value LAB_BACKOFFICE_PASSWORD)" "$primary" \
    pgbench --host=127.0.0.1 --username=topflow_backoffice --no-vacuum --progress=30 \
    --time="$seconds" --client="$clients" --jobs=2 --file=/tmp/pgbench.sql topflow
}

cmd_test() {
  require_env
  ensure_runner
  log "pgTAP suites"
  runner bash -c 'pg_prove --failures tests/pgtap/*.sql'
  log "integration tests"
  runner python -m pytest -q -m integration tests/integration
}

cmd_check() {
  require_env
  ensure_runner
  log "ruff, mypy, unit tests and definitions"
  runner bash -c 'ruff format --check src tests && ruff check src tests && mypy \
    && python -m pytest -q -m "not integration" && python -m pglab validate'
  log "sqlfluff: SQL syntax of the lab's PostgreSQL files and the SQL Server chapter"
  runner sqlfluff lint --dialect postgres --rules LT12 sql/lab sql/security sql/partitioning
  runner sqlfluff lint --dialect tsql --rules LT12 sqlserver/sql
  log "promtool: alert rules, their unit tests and the Prometheus configuration"
  # Works on a copy of the repository mount: on Windows, Docker Desktop could not read
  # some nested bind mounts in this lab's folder.
  docker run --rm --memory 256m -v "$LAB_ROOT_HOST:/src:ro" \
    --entrypoint sh prom/prometheus:v3.15.0 -c \
    'cp -r /src/monitoring/prometheus /tmp/p && cd /tmp/p \
     && promtool check config prometheus.yml >/dev/null \
     && promtool check rules rules/postgres.yml && promtool test rules tests/postgres_test.yml'
  log "shellcheck"
  docker run --rm -v "$LAB_ROOT_HOST:/mnt" -w /mnt koalaman/shellcheck:v0.11.0 \
    --external-sources lab scripts/*.sh docker/postgres/*.sh docker/postgres/initdb/*.sh
  info "static checks passed"
}

cmd_status() {
  require_env
  compose_all ps --format 'table {{.Name}}\t{{.Status}}\t{{.Ports}}'
  local node
  for node in "${LAB_NODES[@]}"; do
    if is_running "$node"; then
      if [ "$(node_query "$node" 'SELECT pg_is_in_recovery()')" = t ]; then
        info "$node: standby"
      else
        info "$node: primary"
      fi
    fi
  done
}

cmd_psql() {
  require_env
  local node="" user=postgres
  while [ $# -gt 0 ]; do
    case $1 in
      --node) node=${2:?}; shift 2 ;;
      --user) user=${2:?}; shift 2 ;;
      *) die "psql: unknown option $1" ;;
    esac
  done
  [ -n "$node" ] || node=$(current_primary) || die "no primary is running (./lab up)"
  ensure_runner
  local password_var
  case $user in
    postgres) password_var=PGPASSWORD ;;
    topflow_migrator) password_var=LAB_MIGRATOR_PASSWORD ;;
    topflow_app) password_var=LAB_APP_PASSWORD ;;
    topflow_backoffice) password_var=LAB_BACKOFFICE_PASSWORD ;;
    topflow_analyst) password_var=LAB_ANALYST_PASSWORD ;;
    *) die "psql: --user must be postgres, topflow_migrator, topflow_app, topflow_backoffice or topflow_analyst" ;;
  esac
  compose exec runner bash -c "PGPASSWORD=\"\$$password_var\" exec psql -h $node -p 5432 -U $user"
}

cmd_down() {
  log "stopping the lab and deleting its volumes"
  if [ -f "$LAB_ROOT/.env" ]; then
    compose_all down --volumes --remove-orphans
  else
    # compose needs the variables to parse the file; placeholders are enough to tear down.
    LAB_POSTGRES_PASSWORD=x LAB_MIGRATOR_PASSWORD=x LAB_APP_PASSWORD=x LAB_BACKOFFICE_PASSWORD=x \
      LAB_ANALYST_PASSWORD=x \
      LAB_REPLICATOR_PASSWORD=x LAB_MONITOR_PASSWORD=x LAB_REWIND_PASSWORD=x LAB_GRAFANA_PASSWORD=x \
      compose_all down --volumes --remove-orphans
  fi
}

main() {
  local cmd=${1:-help}
  [ $# -gt 0 ] && shift
  case $cmd in
    init) cmd_init "$@" ;;
    up) cmd_up "$@" ;;
    migrate) cmd_migrate "$@" ;;
    seed) cmd_seed "$@" ;;
    workload) cmd_workload "$@" ;;
    casebook) cmd_casebook "$@" ;;
    indexing) cmd_indexing "$@" ;;
    partition) cmd_partition "$@" ;;
    partition-maintain) cmd_partition_maintain "$@" ;;
    tune) cmd_tune "$@" ;;
    untune) cmd_untune "$@" ;;
    rls-plans) cmd_rls_plans "$@" ;;
    sqlserver) cmd_sqlserver "$@" ;;
    monitor) cmd_monitor "$@" ;;
    load) cmd_load "$@" ;;
    pitr-drill) pitr_drill "$@" ;;
    replica) cmd_replica "$@" ;;
    switchover) switchover "$@" ;;
    test) cmd_test "$@" ;;
    check) cmd_check "$@" ;;
    status) cmd_status "$@" ;;
    psql) cmd_psql "$@" ;;
    down) cmd_down "$@" ;;
    help | -h | --help) usage ;;
    *)
      usage >&2
      die "unknown command: $cmd"
      ;;
  esac
}

main "$@"
