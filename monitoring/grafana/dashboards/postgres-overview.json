    {
      "id": 13,
      "type": "timeseries",
      "title": "Dead tuple ratio, top tables (bloat indicator)",
      "description": "Dead rows as a share of all rows per table: an estimate of bloat that autovacuum has not cleaned yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(6, pg_stat_user_tables_n_dead_tup{datname=\"topflow\",schemaname=\"public\"} / clamp_min(pg_stat_user_tables_n_live_tup{datname=\"topflow\",schemaname=\"public\"} + pg_stat_user_tables_n_dead_tup{datname=\"topflow\",schemaname=\"public\"}, 1))",
          "legendFormat": "{{node}} {{relname}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
